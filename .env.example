# gpt-oss-azure-opencode-shim — environment variables
#
# Copy to .env and fill in your values, or export these
# in your shell / systemd unit.

# Required — base URL of your Azure AI Foundry endpoint.
# Do NOT include /v1 at the end.
UPSTREAM_URL=https://your-resource.services.ai.azure.com/openai

# API key for the Azure AI Foundry resource. Leave it unset to use
# Entra ID instead (az login / managed identity; needs the [entra] extra).
AZURE_FOUNDRY_API_KEY=your-key-here

# Optional, Entra ID with az login only: skip the managed-identity probe,
# which makes the first request about 2.5 s faster off Azure.
# AZURE_TOKEN_CREDENTIALS=AzureCliCredential

# Optional — bind address and port.
SHIM_HOST=127.0.0.1
SHIM_PORT=9526

# Optional — log level for the shim and uvicorn.
SHIM_LOG_LEVEL=info

# Optional — extra Host header names to accept, comma-separated.
# localhost, 127.0.0.1 and ::1 are always accepted.
# SHIM_ALLOWED_HOSTS=

# Optional — upstream timeouts in seconds.
# SHIM_CONNECT_TIMEOUT=10
# SHIM_READ_TIMEOUT=600

# Optional — record forced requests whose answers are worth replaying later,
# to build regression fixtures (see evals/fixtures.py). Traces never contain
# messages, but the recorded answer is model output: keep the directory local.
# SHIM_TRACE_DIR=~/.local/share/gpt-oss-azure-opencode-shim/traces
# SHIM_TRACE_OUTCOMES=rescued,failed,empty_choices
# The directory also gets one content-free line per chat request
# (outcomes-*.jsonl, read by `gpt-oss-azure-opencode-shim-report`). Old days are deleted:
# SHIM_TRACE_MAX_MB=100
# SHIM_TRACE_RETENTION_DAYS=14

# Optional — OpenTelemetry tracing (needs: pip install '.[otel]')
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_EXPORTER=console

# Optional — answers that miss a forced tool call:
#   on      convert them into that tool call (default)
#   observe leave them unchanged, only count what a repair would do in /metrics
#   off     rewrite tool_choice only
# SHIM_TOOL_POLYFILL=on

# Optional — list prices for the cost estimate (shim_cost_usd_total), in USD
# per 1M tokens as model=input/output. Built-in: gpt-oss-120b, gpt-5-mini.
# SHIM_PRICES=gpt-oss-120b=0.15/0.60,gpt-5-mini=0.25/2.00
