# gpt-oss-azure-opencode-shim — environment variables
#
# Copy to .env and fill in your values, or export these
# in your shell / systemd unit.

# Required — base URL of your Azure AI Foundry endpoint.
# Do NOT include /v1 at the end.
UPSTREAM_URL=https://your-resource.services.ai.azure.com/openai

# Required — API key for the Azure AI Foundry resource.
AZURE_FOUNDRY_API_KEY=your-key-here

# Optional — bind address and port.
SHIM_HOST=127.0.0.1
SHIM_PORT=9526

# Optional — uvicorn log level.
SHIM_LOG_LEVEL=info

# Optional — extra Host header names to accept, comma-separated.
# localhost, 127.0.0.1 and ::1 are always accepted.
# SHIM_ALLOWED_HOSTS=

# Optional — upstream timeouts in seconds.
# SHIM_CONNECT_TIMEOUT=10
# SHIM_READ_TIMEOUT=600
